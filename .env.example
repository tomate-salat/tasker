# Lokal als .env kopieren. Auf Railway stehen diese Werte in den Variables.

# Pfad zur SQLite-Datei. Auf Railway muss er auf dem gemounteten Volume liegen,
# sonst sind die Daten nach jedem Deploy weg.
DATABASE_PATH=./data/tasker.db

# Konto, das beim ersten Start angelegt wird (kommt mit Schritt 3).
# Sobald das Konto existiert, werden beide Werte ignoriert – das Passwort ändert man im Profil.
TASKER_EMAIL=du@example.com
TASKER_PASSWORD=bitte-aendern

# Nur zum Zurücksetzen eines vergessenen Passworts: zusammen mit einem neuen
# TASKER_PASSWORD setzen, einmal deployen, danach wieder entfernen.
# TASKER_PASSWORD_RESET=1

# PORT setzt Railway selbst.
